generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== المدارس (Multi-Tenant) =====
model School {
  id             String    @id @default(cuid())
  name           String
  subdomain      String    @unique
  description    String    @default("")
  logoUrl        String?
  primaryColor   String    @default("#610000")
  secondaryColor String    @default("#009688")
  address        String    @default("")
  phone          String    @default("")
  email          String    @default("")
  facebookUrl    String?
  mapEmbedUrl    String?   // Google Maps embed URL for location map
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // ===== حقول الاشتراك والتسجيل =====
  // حالة الاشتراك العامة (نسخة سريعة للقراءة بدون join)
  subscriptionStatus String @default("PENDING_APPROVAL") // PENDING_APPROVAL|TRIAL|ACTIVE|PAST_DUE|CANCELLED|EXPIRED
  // الباقة المطلوبة عند التسجيل (للموافقة من super-admin)
  pendingPlanId   String?
  // بيانات المسؤول الذي سجّل المدرسة (للتواصل أثناء الموافقة)
  registrantName  String   @default("")
  registrantEmail String   @default("")
  registrantPhone String   @default("")
  registrantUsername String @default("")
  registrantTempPassword String @default("") // كلمة مرور مؤقتة تُولّد عند الموافقة
  // سبب الرفض (إن وُجد)
  rejectionReason String   @default("")
  approvedAt      DateTime?
  approvedById    String?

  settings       Settings?
  users          User[]
  news           News[]
  gallery        Gallery[]
  teachers       Teacher[]
  stats          SchoolStats?
  schedules      Schedule[]
  pages          Page[]
  grades         Grade[]
  results        Result[]
  sliders        Slider[]
  customSections CustomSection[]
  students       Student[]
  expenses       Expense[]
  expenseCategories ExpenseCategory[]
  expenseVendors ExpenseVendor[]
  expenseBudgets ExpenseBudget[]
  recurringExpenses RecurringExpense[]
  pettyCashFunds PettyCash[]
  buses          Bus[]
  busRoutes      BusRoute[]
  transportPayments TransportPayment[]
  fees           Fee[]
  feePayments    FeePayment[]
  attendanceRecords Attendance[]
  employees      Employee[]
  employeeAttendance EmployeeAttendance[]
  salaries       Salary[]
  academicYears  AcademicYear[]
  classrooms     Classroom[]
  conversations  Conversation[]
  messages       Message[]
  announcements  Announcement[]
  events         Event[]
  eventRegistrations EventRegistration[]
  eventReminders EventReminder[]
  eventGallery   EventGallery[]
  eventFeedback  EventFeedback[]
  exams          Exam[]
  examQuestions  Question[]
  examSubmissions Submission[]
  examAnswers    Answer[]
  examViolations ExamViolation[]
  examAppeals    ExamAppeal[]
  examModeration ExamModerationLog[]
  questionBank   QuestionBank[]
  examTeacherProfile ExamTeacherProfile[]
  downloads      DownloadableFile[]
  // ===== اشتراكات SaaS =====
  subscription   SchoolSubscription?
  invoices       Invoice[]
  paymentTransactions PaymentTransaction[]
}

// ===== الإعدادات =====
model Settings {
  id             String   @id @default(cuid())
  schoolId       String   @unique
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  heroTitle      String   @default("")
  heroSubtitle   String   @default("المرحلة الإعدادية")
  bannerTitle    String?
  bannerImageUrl String?
  vision         String?
  aboutImage     String?
  aboutVideoUrl  String?
  showNewsTicker Boolean  @default(true)
  showHeroBanner Boolean  @default(true)
  showLiveStream Boolean  @default(false)
  liveStreamUrl  String?
  facebookUrl    String?
  youtubeUrl     String?
  showSlider     Boolean  @default(true)
  showNews       Boolean  @default(true)
  showServices   Boolean  @default(true)
  showGallery    Boolean  @default(true)
  showTeachers   Boolean  @default(true)
  showStats      Boolean  @default(true)
  showContact    Boolean  @default(true)
  showAbout      Boolean  @default(true)
  sectionOrder   String   @default("[]") // JSON array: ["slider","about","news","services","gallery","teachers","stats","contact"]
  developerName  String   @default("محروس شعبان")
  developerPhoto String?  // URL for developer's circular photo
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ===== المستخدمين / المشرفين =====
model User {
  id          String  @id @default(cuid())
  schoolId    String
  school      School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  username    String
  password    String
  role        String  @default("school_admin") // super_admin, school_admin, teacher
  permissions String  @default("{}") // JSON: {slider:true, news:true, gallery:false, ...}
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, username])
}

// ===== الأخبار =====
model News {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  slug      String?
  excerpt   String?
  content   String?
  image     String?
  category  String   @default("أخبار")
  active    Boolean  @default(true)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, slug])
}

// ===== معرض الصور =====
model Gallery {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String?
  imageUrl  String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== المعلمون =====
model Teacher {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  subject   String
  email     String?
  imageUrl  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== إحصائيات المدرسة =====
model SchoolStats {
  id        String   @id @default(cuid())
  schoolId  String   @unique
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students  Int      @default(0)
  teachers  Int      @default(0)
  classes   Int      @default(0)
  years     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== الصفوف الدراسية والمواد =====
model Grade {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  subjects  String   // JSON string: ["عربي","انجليزي","رياضيات",...]
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== النتائج =====
model Result {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeName  String
  term       String
  students   String   // JSON string: [{seatNumber, studentName, arabic, english, ...}]
  uploadDate DateTime @default(now())
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ===== جداول الحصص =====
model Schedule {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  category    String   @default("class") // class, teacher, daily
  grade       String?
  section     String?
  teacherName String?
  dayOfWeek   Int?
  filePath    String
  fileName    String
  type        String   @default("حالي") // حالي, أرشيف
  active      Boolean  @default(true)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== سلايدر الصور =====
model Slider {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  imageUrl  String
  title     String?
  subtitle  String?
  link      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== الصفحات الثابتة =====
model Page {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, slug])
}

// ===== الأقسام المخصصة =====
model CustomSection {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  content   String   @default("") // HTML content
  imageUrl  String?
  layout    String   @default("full") // full, image-right, image-left, cards
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// ===== وحدات إدارة المدرسة الجديدة =====
// ============================================================

// ===== السنة الدراسية =====
model AcademicYear {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String   // "2024/2025"
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classrooms  Classroom[]
  fees        Fee[]
  attendanceRecords Attendance[]
  expenses    Expense[]
  expenseBudgets ExpenseBudget[]
  announcements Announcement[]
  events        Event[]

  @@unique([schoolId, name])
}

// ===== الفصول الدراسية =====
model Classroom {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String   // "الصف الأول - أ"
  gradeLevel     String   // "الصف الأول الإعدادي"
  section        String   @default("أ") // أ، ب، ج
  capacity       Int      @default(30)
  teacherId      String?  // معلم الفصل
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  students       Student[]
  attendanceRecords Attendance[]

  @@unique([schoolId, academicYearId, name])
}

// ===== الطلاب =====
model Student {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classroomId    String?
  classroom      Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  studentNumber  String   // رقم الطالب
  name           String   // الاسم
  nationalId     String?  // الرقم القومي
  dateOfBirth    DateTime? // تاريخ الميلاد
  gender         String   @default("ذكر") // ذكر، أنثى
  address        String?  // العنوان
  phone          String?  // هاتف ولي الأمر
  parentName     String?  // اسم ولي الأمر
  parentPhone    String?  // هاتف ولي الأمر الأول
  parentPhone2   String?  // هاتف ولي الأمر الثاني
  parentNationalId String? // الرقم القومي لولي الأمر
  enrollDate     DateTime @default(now()) // تاريخ القيد
  status         String   @default("نشط") // نشط، منقول، منسحب، متخرج
  previousSchool String?  // المدرسة السابقة
  notes          String?  // ملاحظات
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feePayments    FeePayment[]
  studentFees    StudentFee[]
  attendanceRecords Attendance[]
  transport      StudentTransport?

  @@unique([schoolId, studentNumber])
}

// ===== المصروفات =====
model Expense {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId  String?
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendorId        String?
  vendor          ExpenseVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  recurringExpenseId String?
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  title           String   // بيان المصروف
  amount          Float    // المبلغ
  expenseDate     DateTime // تاريخ الصرف
  paymentMethod   String   @default("نقدي") // نقدي، تحويل، شيك، بطاقة
  recipient       String?  // المستلم
  reference       String?  // رقم المرجع / الإيصال
  checkNumber     String?  // رقم الشيك
  bankName        String?  // البنك
  checkDate       DateTime? // تاريخ استحقاق الشيك (للشيكات المؤجلة)
  attachments     String?  // JSON array of file URLs
  notes           String?  // ملاحظات
  status          String   @default("مدفوع") // مسودة، معلق، معتمد، مدفوع، مرفوض
  createdBy       String?  // من أنشأ السجل
  approvedBy      String?  // من اعتمد السجل
  approvedAt      DateTime? // تاريخ الاعتماد
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  approvals       ExpenseApproval[]
  pettyCashTx     PettyCashTransaction[]

  @@index([schoolId, expenseDate])
  @@index([schoolId, categoryId])
  @@index([schoolId, status])
}

// ===== تصنيفات المصروفات =====
model ExpenseCategory {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String   // رواتب، صيانة، كهرباء، ماء، قرطاسية...
  parentId  String?  // للتصنيفات الفرعية
  parent    ExpenseCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  ExpenseCategory[] @relation("CategoryHierarchy")
  icon      String?  // أيقونة (Lucide name)
  color     String?  // لون (hex)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses  Expense[]
  budgets   ExpenseBudget[]
  recurringExpenses RecurringExpense[]

  @@unique([schoolId, name])
}

// ===== الموردون / المستفيدون =====
model ExpenseVendor {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String   // اسم المورد
  type          String   @default("مورد") // مورد، مقاول، جهة حكومية، مستفيد
  contactPerson String?  // المسؤول
  phone         String?  // الهاتف
  email         String?  // البريد
  address       String?  // العنوان
  taxNumber     String?  // البطاقة الضريبية
  taxOffice     String?  // المأمورية
  bankName      String?  // البنك
  bankAccount   String?  // رقم الحساب
  openingBalance Float   @default(0) // الرصيد الافتتاحي
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expenses      Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([schoolId, name])
}

// ===== الميزانيات =====
model ExpenseBudget {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  period          String   // سنوي، ربعي، شهري
  fiscalMonth     Int?     // 1-12 (للميزانية الشهرية)
  fiscalQuarter   Int?     // 1-4 (للميزانية الربعية)
  amount          Float    // المبلغ المخصص
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([schoolId, academicYearId, categoryId, period, fiscalMonth, fiscalQuarter])
}

// ===== المصروفات المتكررة =====
model RecurringExpense {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendorId        String?
  vendor          ExpenseVendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  title           String   // بيان المصروف
  amount          Float    // المبلغ
  frequency       String   // أسبوعي، شهري، ربعي، سنوي
  startDate       DateTime // تاريخ بدء التكرار
  endDate         DateTime? // تاريخ انتهاء التكرار (null = لا نهائي)
  nextRunDate     DateTime // تاريخ التشغيل التالي
  lastRunDate     DateTime? // تاريخ آخر تشغيل
  paymentMethod   String   @default("نقدي")
  recipient       String?
  reference       String?
  notes           String?
  active          Boolean  @default(true)
  autoGenerate    Boolean  @default(false) // إنشاء تلقائي دون تدخل
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  expenses        Expense[]

  @@index([schoolId, nextRunDate])
}

// ===== العهد (الصندوق الصغير) =====
model PettyCash {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String   // اسم الصندوق
  custodianId   String?  // أمين العهد (Employee ID)
  custodianName String?  // اسم أمين العهد (نص حر)
  openingBalance Float   @default(0) // الرصيد الافتتاحي
  currentBalance Float   @default(0) // الرصيد الحالي
  maximumBalance Float?  // الحد الأقصى للصندوق
  active        Boolean  @default(true)
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions  PettyCashTransaction[]

  @@unique([schoolId, name])
}

// ===== حركات العهد =====
model PettyCashTransaction {
  id            String   @id @default(cuid())
  pettyCashId   String
  pettyCash     PettyCash @relation(fields: [pettyCashId], references: [id], onDelete: Cascade)
  schoolId      String
  type          String   // صرف، تغذية، تسوية
  amount        Float    // المبلغ
  expenseId     String?  // ربط بالمصروف (للصرف)
  expense       Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  recipient     String?  // المستلم
  date          DateTime // تاريخ الحركة
  reference     String?  // رقم الإيصال
  notes         String?
  balanceAfter  Float    // الرصيد بعد الحركة
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([pettyCashId, date])
}

// ===== سجل اعتماد المصروفات =====
model ExpenseApproval {
  id            String   @id @default(cuid())
  expenseId     String
  expense       Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  schoolId      String
  approverId    String?  // معرف المستخدم المعتمد
  approverName  String   // اسم المعتمد
  approverRole  String?  // دور المعتمد
  action        String   // اعتماد، رفض، طلب تعديل
  notes         String?  // ملاحظات الاعتماد
  approvedAt    DateTime @default(now())
}

// ===== الباصات =====
model Bus {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plateNumber     String   // رقم اللوحة
  driverName      String   // اسم السائق
  driverPhone     String?  // هاتف السائق
  driverLicense   String?  // رقم رخصة السائق
  supervisorName  String?  // اسم المشرف
  supervisorPhone String?  // هاتف المشرف
  capacity        Int      @default(30) // السعة
  model           String?  // موديل الباص
  color           String?  // لون الباص (للتمييز)
  active          Boolean  @default(true)
  notes           String?  // ملاحظات
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  routes          BusRoute[]

  @@unique([schoolId, plateNumber])
}

// ===== خطوط الباص =====
model BusRoute {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  busId        String
  bus          Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  name         String   // اسم الخط / المنطقة
  area         String   // المنطقة الجغرافية
  morningTime  String?  // موعد الصباح
  afternoonTime String? // موعد الظهيرة
  stops        String   @default("[]") // JSON: [{"name":"محطة 1","time":"7:00"},...]
  monthlyFee   Float    @default(0) // الاشتراك الشهري
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions StudentTransport[]
}

// ===== اشتراكات النقل =====
model StudentTransport {
  id           String   @id @default(cuid())
  schoolId     String
  studentId    String   @unique
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routeId      String
  route        BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  startDate    DateTime // بداية الاشتراك
  endDate      DateTime? // نهاية الاشتراك
  direction    String   @default("ذهاب وعودة") // ذهاب، عودة، ذهاب وعودة
  monthlyFee   Float    @default(0) // قد يختلف عن رسوم الخط
  status       String   @default("نشط") // نشط، ملغي، متوقف
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments     TransportPayment[]
}

// ===== مدفوعات النقل =====
model TransportPayment {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   StudentTransport @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  month          Int      // الشهر 1-12
  year           Int      // السنة
  amount         Float    // المبلغ المدفوع
  paymentDate    DateTime // تاريخ الدفع
  paymentMethod  String   @default("نقدي") // نقدي، تحويل، بطاقة
  receiptNumber  String?  // رقم الإيصال
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([schoolId, subscriptionId, month, year])
}

// ===== الرسوم والأقساط =====
model Fee {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String   // "رسوم الدراسة - الصف الأول"
  gradeLevel     String?  // الصف الدراسي (null = جميع الصفوف)
  totalAmount    Float    // إجمالي الرسوم
  installments   Int      @default(1) // عدد الأقساط
  installmentAmount Float? // قيمة القسط (يُحسب تلقائياً)
  dueDates       String   @default("[]") // JSON: ["2024-09-01","2024-12-01","2025-03-01"]
  feeType        String   @default("دراسة") // دراسة، أنشطة، كتب، أخرى
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments       FeePayment[]
  feeInstallments FeeInstallment[]
  studentFees    StudentFee[]
}

// ===== أقساط الرسوم =====
model FeeInstallment {
  id            String   @id @default(cuid())
  schoolId      String
  feeId         String
  fee           Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  installmentNo Int      // رقم القسط (1، 2، 3...)
  amount        Float    // مبلغ القسط
  dueDate       DateTime // تاريخ الاستحقاق
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments      FeePayment[]

  @@unique([schoolId, feeId, installmentNo])
}

// ===== تخصيص الرسوم للطلاب =====
model StudentFee {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeId          String
  fee            Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  totalAmount    Float    // الإجمالي بعد الخصم
  discountType   String?  // نسبة، ثابت، إعفاء
  discountValue  Float?   // قيمة الخصم
  discountReason String?  // سبب الخصم
  assignedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments       FeePayment[]

  @@unique([schoolId, studentId, feeId])
}

// ===== دفعات الأقساط =====
model FeePayment {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeId         String
  fee           Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentFeeId  String?  // ربط بتخصيص الرسوم
  studentFee    StudentFee? @relation(fields: [studentFeeId], references: [id], onDelete: SetNull)
  installmentId String?  // ربط بالقسط المحدد
  installment   FeeInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  amount        Float    // المبلغ المدفوع
  paymentDate   DateTime // تاريخ الدفع
  paymentMethod String   @default("نقدي") // نقدي، تحويل، بطاقة، شيك
  receiptNumber String?  // رقم الإيصال
  installmentNo Int      @default(1) // رقم القسط
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===== الحضور والغياب =====
model Attendance {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear  AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classroomId   String?
  classroom     Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date          DateTime // تاريخ اليوم
  status        String   @default("حاضر") // حاضر، غائب، غائب بعذر، متأخر
  arrivalTime   String?  // وقت الحضور
  notes         String?  // سبب الغيب أو ملاحظة
  recordedBy    String?  // من سجل
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, studentId, date])
}

// ===== الموظفين =====
model Employee {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employeeNumber String   // رقم الموظف
  name           String   // الاسم
  nationalId     String?  // الرقم القومي
  jobTitle       String   // المسمى الوظيفي
  department     String?  // القسم
  qualification  String?  // المؤهل
  specialization String?  // التخصص
  hireDate       DateTime? // تاريخ التعيين
  phone          String?  // الهاتف
  email          String?  // البريد
  address        String?  // العنوان
  salary         Float    @default(0) // الراتب الأساسي
  allowances     Float    @default(0) // البدلات
  deductions     Float    @default(0) // الخصومات الثابتة
  contractType   String   @default("دائم") // دائم، مؤقت، جزء وقت
  status         String   @default("نشط") // نشط، إجازة، مستقيل
  bankName       String?  // البنك
  bankAccount    String?  // رقم الحساب البنكي
  imageUrl       String?  // الصورة
  notes          String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salaries       Salary[]
  attendanceRecords EmployeeAttendance[]

  @@unique([schoolId, employeeNumber])
}

// ===== الرواتب =====
model Salary {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month          Int      // الشهر 1-12
  year           Int      // السنة
  basicSalary    Float    // الراتب الأساسي
  allowances     Float    @default(0) // البدلات
  overtime       Float    @default(0) // ساعات إضافية
  bonus          Float    @default(0) // مكافآت
  deductions     Float    @default(0) // الخصومات
  advancePayment Float    @default(0) // السلف
  insurance      Float    @default(0) // التأمينات
  taxes          Float    @default(0) // الضرائب
  netSalary      Float    // الصافي (يُحسب تلقائياً)
  paymentDate    DateTime? // تاريخ الصرف
  paymentMethod  String   @default("تحويل") // تحويل، نقدي، شيك
  status         String   @default("معلق") // معلق، مدفوع، ملغي
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([schoolId, employeeId, month, year])
}

// ===== حضور وغياب الموظفين =====
model EmployeeAttendance {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime // تاريخ اليوم
  status         String   @default("حاضر") // حاضر، غائب، متأخر، إجازة مرضية، إجازة رسمية، إجازة شخصية
  checkIn        String?  // وقت الحضور
  checkOut       String?  // وقت الانصراف
  leaveType      String?  // نوع الإجازة: مرضية، رسمية، شخصية، أمومة، أخرى
  leaveDuration  String?  @default("يوم كامل") // يوم كامل، نصف يوم
  notes          String?  // سبب الغياب أو ملاحظة
  recordedBy     String?  // من سجل
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([schoolId, employeeId, date])
}

// ===== التواصل والإشعارات — المرحلة الأولى =====

// المحادثات (فردية / مجموعة / إدارية)
model Conversation {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type          String    @default("فردية") // فردية، مجموعة، إدارية
  title         String    @default("") // عنوان المحادثة (للمجموعات)
  participants  String    @default("[]") // JSON array of userIds
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages      Message[]

  @@index([schoolId])
}

// الرسائل الخاصة بين المستخدمين
model Message {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  senderId       String    // معرف المرسل
  senderName     String    @default("") // اسم المرسل (نسخة سريعة)
  senderRole     String    @default("") // دور المرسل (مدير، معلم، موظف...)
  recipientId    String    // معرف المستلم
  recipientName  String    @default("") // اسم المستلم
  subject        String    @default("") // الموضوع
  content        String    // نص الرسالة
  attachments    String?   // JSON array of file URLs
  priority       String    @default("عادي") // عادي، عاجل، هام
  isRead         Boolean   @default(false)
  readAt         DateTime?
  isStarred      Boolean   @default(false) // تم التمييز بنجمة
  isArchived     Boolean   @default(false) // مؤرشف
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([schoolId, recipientId])
  @@index([schoolId, senderId])
}

// الإعلانات الموجهة
model Announcement {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear  AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  title         String    // عنوان الإعلان
  content       String    // محتوى الإعلان
  targetType    String    @default("الكل") // الكل، صف، مرحلة، موظفين، أولياء أمور، معلمين
  targetIds     String    @default("[]") // JSON array للمعرفات المستهدفة (صفوف/مراحل)
  authorId      String    // معرف المنشئ
  authorName    String    @default("") // اسم المنشئ
  imageUrl      String?   // صورة مرفقة
  isPinned       Boolean   @default(false) // مثبت
  isPublished   Boolean   @default(true) // منشور
  publishedAt   DateTime? // تاريخ النشر
  expiresAt     DateTime? // تاريخ الانتهاء
  viewCount     Int       @default(0) // عدد المشاهدات
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([schoolId, isPublished])
  @@index([schoolId, targetType])
}

// ===== الفعاليات والأحداث =====

model Event {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String?
  academicYear  AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  title         String
  description   String    @default("")
  type          String    @default("نشاط")
  status        String    @default("مجدولة")
  startDate     DateTime
  endDate       DateTime?
  location      String    @default("")
  coverImageUrl String?
  organizerId   String
  organizerName String    @default("")
  targetAudience String   @default("الكل")
  targetIds     String    @default("[]")
  maxAttendees  Int?
  isPublic      Boolean   @default(true)
  program       String?
  requirements  String?
  budget        Float?
  aiGenerated   Boolean   @default(false)
  viewCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  registrations EventRegistration[]
  reminders     EventReminder[]
  gallery       EventGallery[]
  feedback      EventFeedback[]

  @@index([schoolId, status])
  @@index([schoolId, type])
  @@index([schoolId, startDate])
}

model EventRegistration {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrantId   String
  registrantName String   @default("")
  registrantType String   @default("طالب")
  status         String   @default("مسجل")
  registeredAt   DateTime @default(now())
  attendedAt     DateTime?
  notes          String?

  @@unique([schoolId, eventId, registrantId])
  @@index([eventId])
}

model EventReminder {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sendAt      DateTime
  channel     String   @default("داخلي")
  message     String
  sent        Boolean  @default(false)
  sentAt      DateTime?
  targetCount Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([eventId])
}

model EventGallery {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  imageUrl   String
  caption    String?
  uploadedAt DateTime @default(now())

  @@index([eventId])
}

model EventFeedback {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewerName String   @default("")
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  @@unique([schoolId, eventId, reviewerId])
  @@index([eventId])
}

// ====================================================================
// ===== وحدة إدارة الامتحانات (Exams Management) =====
// كل العمليات الأمنية في الباك إند: فحص الملفات + تعقيم + إشراف AI
// ====================================================================

// ----- التعدادادات (Enums) -----
enum ExamStatus {
  DRAFT          // مسودة
  PUBLISHED      // منشور
  CLOSED         // مغلق
  ARCHIVED       // مؤرشف
}

// فئة الامتحان: تدريبي (practice) أو رسمي (official)
enum ExamCategory {
  TRAINING       // تدريبي — يسمح بإعادة المحاولة، تصحيح فوري، يعرض الإجابات
  OFFICIAL       // رسمي — امتحان حقيقي يؤثر على الدرجة النهائية
}

// الفئة الزمنية للامتحان التدريبي (مثل Oracle Academy)
enum ExamPeriod {
  NONE           // بدون فئة (للرسمي أو المخصص)
  WEEKLY         // أسبوعي (نهاية الأسبوع)
  MIDMONTH       // نصف شهري (منتصف الشهر)
  MONTHLY        // شهري (نهاية الشهر)
  CUMULATIVE     // تراكمي (نهاية الترم)
}

enum QuestionType {
  MCQ            // اختيار من متعدد
  TRUE_FALSE     // صح/خطأ
  SHORT          // إجابة قصيرة
  ESSAY          // مقال
  IMAGE_ANSWER   // رفع صورة (خط يدوي)
  FILE_PDF       // رفع PDF
}

enum SubmissionStatus {
  IN_PROGRESS    // قيد الحل
  SUBMITTED      // تم التسليم
  GRADED         // تم التصحيح
  FLAGGED        // مُعلَّق للمراجعة
  AUTO_CLOSED    // أُغلق تلقائياً (انتهى الوقت)
}

enum ModerationStatus {
  PENDING        // بانتظار الفحص
  SAFE           // آمن
  FLAGGED        // مُعلَّق
  BLOCKED        // مرفوض
  ERROR          // خطأ في الفحص
}

enum ViolationType {
  TAB_SWITCH            // مغادرة الصفحة
  COPY_ATTEMPT          // محاولة نسخ
  PASTE_ATTEMPT         // محاولة لصق
  MULTIPLE_DEVICES      // تعدد الأجهزة
  SUSPICIOUS_FILE       // ملف مشبوه
  RATE_LIMIT_EXCEEDED   // تجاوز معدل الإرسال
  FOCUS_LOSS            // فقدان التركيز
  RIGHT_CLICK           // زر الفأرة الأيمن
  SHORTCUT_KEY          // اختصار لوحة المفاتيح
}

enum AppealStatus {
  PENDING        // قيد النظر
  APPROVED       // مقبول
  REJECTED       // مرفوض
}

enum ModerationAction {
  AUTO_ALLOWED      // سماح تلقائي (آمن)
  AUTO_BLOCKED      // رفض تلقائي (مرفوض)
  AUTO_FLAGGED      // تعليق تلقائي للمراجعة البشرية
  HUMAN_APPROVED    // سماح بشري بعد تعليق
  HUMAN_REJECTED    // رفض بشري بعد تعليق
}

// ----- نماذج الامتحانات -----
model Exam {
  id              String    @id @default(cuid())
  schoolId        String
  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title           String
  description     String    @default("")
  subject         String    // المادة (نص حر لتفادي الربط الإجباري)
  subjectId       String?   // معرف المادة إن وُجد في جدول آخر
  teacherId       String    // مُنشئ الامتحان
  teacherName     String    @default("")  // اسم المعلم (للعرض السريع)
  classroomId     String?   // الفصل المستهدف
  classroomName   String    @default("")  // اسم الفصل (للعرض)
  academicYearId  String?   // السنة الدراسية
  startDate       DateTime  // وقت الفتح
  endDate         DateTime  // وقت الإغلاق
  durationMinutes Int       // المدة بالدقائق
  passwordHash    String?   // كلمة سر الدخول (مشفرّة bcrypt)
  shuffleQuestions Boolean   @default(false)
  shuffleOptions   Boolean   @default(false)
  allowReview      Boolean   @default(true)   // السماح للطالب بمراجعة إجاباته بعد التسليم
  showResultImmediately Boolean @default(false) // إظهار النتيجة فوراً
  parentVisible    Boolean   @default(false)   // هل يرى ولي الأمر الورقة؟
  maxAttempts      Int       @default(1)
  maxFileSizeMb    Int       @default(5)
  allowTextAnswers Boolean   @default(true)
  allowImageAnswers Boolean  @default(true)
  allowPdfAnswers  Boolean   @default(false)
  ipRestriction    String?   // قيد IP اختياري
  antiCheatEnabled Boolean   @default(true)
  status           ExamStatus @default(DRAFT)
  totalPoints      Float     @default(0)
  passingScore     Float?    // درجة النجاح
  // ===== امتحانات تدريبية (مثل Oracle Academy) =====
  category         ExamCategory @default(OFFICIAL) // تدريبي أو رسمي
  examPeriod       ExamPeriod   @default(NONE)     // الفئة الزمنية للتدريبي
  showAnswersAfter Boolean   @default(false) // إظهار الإجابات الصحيحة بعد التسليم (للتدريبي)
  allowRetakes     Boolean   @default(false) // السماح بإعادة المحاولة بدون حد (للتدريبي)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  questions   Question[]
  submissions Submission[]

  @@index([schoolId])
  @@index([teacherId])
  @@index([classroomId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([category])
  @@index([examPeriod])
}

model Question {
  id            String       @id @default(cuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examId        String
  exam          Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  type          QuestionType
  text          String       // نص السؤال (بعد الفلترة عند الإنشاء)
  options       String?      // JSON array: ["خيار 1", "خيار 2", ...]
  correctAnswer String?      // للـ MCQ/TRUE_FALSE: index أو "true"/"false"
  correctText   String?      // للـ SHORT: نص نموذجي
  rubric        String?      // لـ ESSAY: معايير التصحيح JSON
  points        Float        @default(1)
  order         Int          @default(0)
  explanation   String?      // تفسير الإجابة (يظهر بعد التصحيح)
  attachmentPath String?     // مسار صورة السؤال في secure-storage
  attachmentUrl  String?     // URL للعرض (مؤقت)
  textModeration  ModerationStatus @default(PENDING)
  imageModeration  ModerationStatus @default(PENDING)
  moderationNotes String?          // JSON: أسباب قرار الـ AI
  moderatedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  answers Answer[]

  @@index([examId])
  @@index([schoolId])
}

model Submission {
  id              String           @id @default(cuid())
  schoolId        String
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  examId          String
  exam            Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId       String
  studentName     String           @default("")
  attemptNumber   Int              @default(1)
  startedAt       DateTime         @default(now())
  submittedAt     DateTime?
  autoClosedAt    DateTime?        // متى أُغلق تلقائياً
  status          SubmissionStatus @default(IN_PROGRESS)
  totalScore      Float?
  maxScore        Float?
  percentage      Float?
  passed          Boolean?
  ipHash          String           @default("")  // بصمة الجهاز
  userAgentHash   String           @default("")
  focusEvents     Int              @default(0)
  tabSwitches     Int              @default(0)
  copyAttempts    Int              @default(0)
  lastActivityAt  DateTime?
  gradedAt        DateTime?
  gradedById      String?
  gradedByName    String?          @default("")
  notes           String           @default("")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  answers     Answer[]
  violations  ExamViolation[]
  appeals     ExamAppeal[]

  @@unique([examId, studentId, attemptNumber])
  @@index([examId])
  @@index([studentId])
  @@index([status])
  @@index([schoolId])
}

model Answer {
  id              String           @id @default(cuid())
  schoolId        String
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submissionId    String
  submission      Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  textAnswer      String?          // النص بعد الفلترة والتعقيم
  textOriginalLength Int           @default(0)  // الطول الأصلي قبل التعقيم (للإحصاء)
  imageAnswerPath String?          // مسار الصورة في secure-storage (آمن)
  imageAnswerUrl  String?          // URL مؤقت للعرض
  fileAnswerPath  String?          // مسار PDF في secure-storage
  fileAnswerUrl   String?          // URL مؤقت للعرض
  imageHash       String?          // hash بصري للصورة (anti-cheat)
  textModeration  ModerationStatus @default(PENDING)
  imageModeration ModerationStatus @default(PENDING)
  fileModeration  ModerationStatus @default(PENDING)
  moderationNotes String?          // JSON: أسباب قرار الـ AI
  moderatedAt     DateTime?
  score           Float?
  maxScore        Float            @default(1)
  isCorrect       Boolean?
  teacherNote     String?
  aiSuggestedScore Float?          // اقتراح AI للدرجة
  aiConfidence    Float?           // ثقة AI (0-1)
  aiAssisted      Boolean          @default(false)  // هل استُخدم AI في التصحيح
  lastAiAssistAt  DateTime?        // متى آخر اقتراح AI
  gradedAt        DateTime?
  gradedById      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  appeals     ExamAppeal[]
  moderationLogs ExamModerationLog[]

  @@index([submissionId])
  @@index([questionId])
  @@index([schoolId])
  @@index([textModeration])
  @@index([imageModeration])
}

model ExamViolation {
  id            String        @id @default(cuid())
  schoolId      String
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  submissionId  String
  submission    Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  examId        String         @default("")
  studentId     String         @default("")
  type          ViolationType
  severity      Int           @default(1)  // 1=منخفض، 2=متوسط، 3=عالي
  details       String        @default("")
  userAgent     String        @default("")
  ipHash        String        @default("")
  createdAt     DateTime      @default(now())

  @@index([submissionId])
  @@index([examId])
  @@index([studentId])
  @@index([type])
  @@index([schoolId])
}

model ExamAppeal {
  id            String      @id @default(cuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  answerId      String
  answer        Answer      @relation(fields: [answerId], references: [id], onDelete: Cascade)
  submissionId  String
  submission    Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  studentId     String
  studentName   String      @default("")
  reason        String
  requestedScore Float?
  status        AppealStatus @default(PENDING)
  teacherReply  String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([answerId])
  @@index([submissionId])
  @@index([status])
  @@index([schoolId])
}

model ExamModerationLog {
  id            String           @id @default(cuid())
  schoolId      String
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  answerId      String?
  answer        Answer?          @relation(fields: [answerId], references: [id], onDelete: SetNull)
  questionId    String?
  action        ModerationAction
  targetType    String           @default("text")  // text|image|pdf|file
  reason        String           @default("")
  aiConfidence  Float?
  reviewerId    String?
  reviewerName  String           @default("")
  metadata      String?          // JSON إضافي
  createdAt     DateTime         @default(now())

  @@index([answerId])
  @@index([action])
  @@index([schoolId])
}

// ----- بنك الأسئلة (Question Bank) -----
// أسئلة قابلة لإعادة الاستخدام عبر الامتحانات، يصنعها المعلم ويصنّفها.
model QuestionBank {
  id            String       @id @default(cuid())
  schoolId      String
  school        School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId     String
  teacherName   String       @default("")
  subject       String       @default("")   // المادة (لتصفية بنك الأسئلة)
  classroomName String       @default("")   // الصف المستهدف (اختياري)
  type          QuestionType
  text          String       // نص السؤال (بعد الفلترة)
  options       String?      // JSON array
  correctAnswer String?
  correctText   String?
  rubric        String?      // معايير التصحيح JSON
  points        Float        @default(1)
  explanation   String?
  tags          String       @default("[]") // JSON array of tags
  difficulty    String       @default("medium")  // easy|medium|hard
  usageCount    Int          @default(0)   // عدد مرات الاستخدام في امتحانات
  isPublic      Boolean      @default(false) // مرئي لمعلمي المدرسة الآخرين؟
  textModeration  ModerationStatus @default(PENDING)
  imageModeration  ModerationStatus @default(PENDING)
  moderationNotes String?
  moderatedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([schoolId])
  @@index([teacherId])
  @@index([subject])
  @@index([type])
  @@index([isPublic])
}

// ----- ملف المعلم للامتحانات -----
// يخزّن إعدادات المعلم الافتراضية + إحصاءات سريعة.
model ExamTeacherProfile {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId       String   @unique
  teacherName     String   @default("")
  defaultSubject  String   @default("")
  defaultDurationMinutes Int @default(30)
  defaultMaxAttempts Int   @default(1)
  defaultPassingScore Float @default(50)
  defaultAllowText Boolean  @default(true)
  defaultAllowImage Boolean @default(true)
  defaultAllowPdf  Boolean  @default(false)
  defaultAntiCheat Boolean  @default(true)
  totalExamsCreated Int    @default(0)
  totalQuestionsInBank Int @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ===== مركز التحميل — ملفات قابلة للتحميل لشئون الطلاب/العاملين/الموارد المالية =====
model DownloadableFile {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  // تصنيف الملف: شئون الطلاب / شئون العاملين / شئون مالية / إدارية / عام
  category        String   @default("GENERAL")
  title           String   // عنوان عربي واضح
  description     String   @default("")
  fileName        String   // الاسم الأصلي للملف (للعرض عند التحميل)
  filePath        String   // المسار النسبي على القرص
  fileType        String   @default("") // MIME type
  fileSize        Int      @default(0)  // بالبايت
  uploadedById    String?
  uploadedByName  String   @default("")
  isActive        Boolean  @default(true)  // إخفاء/إظهار بدون حذف
  downloadsCount  Int      @default(0)  // عدّاد التحميلات
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, category])
  @@index([schoolId, isActive])
  @@index([category, isActive])
}

// ============================================================
// ===== نظام الاشتراكات SaaS (3 باقات + فترة تجريبية) =====
// ============================================================

// باقات النظام — يديرها super-admin (3 سجلات ثابتة)
model SubscriptionPlan {
  id              String   @id @default(cuid())
  code            String   @unique  // "basic" | "pro" | "enterprise"
  nameAr          String             // "الباقة الأساسية"
  description     String   @default("")
  // الأسعار بالجنيه المصري
  priceMonthly    Float               // السعر الشهري
  priceAnnual     Float               // السعر السنوي (مع خصم ≈ شهران مجانًا)
  trialDays       Int      @default(14)
  // الحدود (null = غير محدود)
  maxStudents     Int?
  maxTeachers     Int?
  maxAdmins       Int?
  maxStorageMb    Int
  // الميزات المُفعّلة (JSON array of module keys)
  // مثال: ["news","students","exams_training","exams_official","transport","fees","expenses","staff"]
  features        String   @default("[]")
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions   SchoolSubscription[]
  invoices        Invoice[]
}

// اشتراك المدرسة — واحد نشط لكل مدرسة
model SchoolSubscription {
  id              String   @id @default(cuid())
  schoolId        String   @unique
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  // حالة الاشتراك
  status          String   @default("PENDING_APPROVAL") // PENDING_APPROVAL|TRIAL|ACTIVE|PAST_DUE|CANCELLED|EXPIRED
  startDate       DateTime @default(now())
  trialEndDate    DateTime?    // نهاية الفترة التجريبية
  currentPeriodEnd DateTime   // نهاية الفترة المدفوعة الحالية
  billingCycle    String   @default("MONTHLY") // MONTHLY|ANNUAL
  autoRenew       Boolean  @default(true)
  cancelledAt     DateTime?
  // الباقة المطلوبة للدورة التالية (للترقية/التخفيض من بداية الدورة القادمة)
  pendingPlanId   String?  // إن وُجد، يسري عند التجديد التالي
  pendingCycle    String?  // MONTHLY|ANNUAL (إن غُيّرت دورة الفوترة)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoices        Invoice[]

  @@index([status])
  @@index([planId])
}

// الفاتورة
model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique   // INV-2025-0001
  subscriptionId  String
  subscription    SchoolSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  amount          Float               // المبلغ بالجنيه
  currency        String   @default("EGP")
  periodStart     DateTime
  periodEnd       DateTime
  // حالة الفاتورة
  status          String   @default("PENDING") // PENDING|PAID|FAILED|REFUNDED|VOID
  dueDate         DateTime
  paidAt          DateTime?
  paymentMethod   String?  // paymob|manual|stripe
  // بيانات إضافية للدفع اليدوي (تحويل بنكي)
  manualReceiptUrl String? // رابط إيصال التحويل المرفوع
  manualNotes     String   @default("") // ملاحظات من المدرسة
  reviewedAt      DateTime? // تاريخ مراجعة super-admin
  reviewedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    PaymentTransaction[]

  @@index([schoolId, status])
  @@index([subscriptionId])
  @@index([status, dueDate])
}

// حركة الدفع (لكل محاولة دفع سجل)
model PaymentTransaction {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gateway         String   // paymob|manual|stripe
  gatewayRef      String?  // مرجع البوابة (merchant_order_id لـ Paymob)
  amount          Float
  currency        String   @default("EGP")
  status          String   @default("PENDING") // PENDING|SUCCESS|FAILED|REFUNDED
  payload         String   @default("{}") // JSON: استجابة البوابة الكاملة
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([invoiceId])
  @@index([schoolId])
  @@index([gateway, status])
}
